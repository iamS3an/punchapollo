{
  "name": "punchapollo",
  "version": "1.0.0",
  "description": "Keeps a working day's attendance record on schedule through a dedicated Edge profile.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clock:in": "PUNCH_ACTION=clock-in bash scripts/run-clock-in.sh",
    "clock:out": "PUNCH_ACTION=clock-out bash scripts/run-clock-in.sh",
    "clock:plan": "PUNCH_ACTION=plan bash scripts/run-clock-in.sh",
    "config:show": "bash scripts/show-config.sh",
    "cron:install": "bash scripts/install-cron.sh",
    "edge:start": "bash scripts/start-edge.sh",
    "location:set": "bash scripts/location-set.sh",
    "session:login": "bash scripts/session-login.sh",
    "password:set": "bash scripts/set-secret.sh password",
    "session:test": "bash scripts/session-test.sh",
    "totp:set": "bash scripts/set-secret.sh totp"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  }
}
