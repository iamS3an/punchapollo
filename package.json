{
  "name": "punchapollo",
  "version": "1.0.0",
  "description": "Keeps a working day's attendance record on schedule through a dedicated Edge profile.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clock:in": "node.exe src/cli.js clock clock-in",
    "clock:out": "node.exe src/cli.js clock clock-out",
    "clock:plan": "node.exe src/cli.js clock plan",
    "config:show": "node.exe src/cli.js config-show",
    "daemon:start": "node.exe src/daemon-ctl.js start",
    "daemon:stop": "node.exe src/daemon-ctl.js stop",
    "daemon:restart": "node.exe src/daemon-ctl.js restart",
    "daemon:logs": "node.exe src/daemon-ctl.js logs",
    "daemon:status": "node.exe src/daemon-ctl.js status",
    "location:set": "node.exe src/cli.js location-set",
    "session:login": "node.exe src/cli.js session-login",
    "password:set": "node.exe src/cli.js set-secret password",
    "session:test": "node.exe src/cli.js session-test",
    "totp:set": "node.exe src/cli.js set-secret totp",
    "daemon:register": "node.exe src/daemon-ctl.js register",
    "daemon:unregister": "node.exe src/daemon-ctl.js unregister"
  },
  "dependencies": {
    "pm2": "^5.4.2",
    "playwright-core": "^1.55.0"
  }
}
